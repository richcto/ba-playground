# PostgreSQL (defaults work for local dev)
POSTGRES_USER=backstage
POSTGRES_PASSWORD=backstage
POSTGRES_DB=backstage

# Required for triggering the deploy-kafka workflow
# Create a PAT at https://github.com/settings/tokens with 'workflow' scope
GITHUB_TOKEN=

# Kafka UI (AKHQ) - bootstrap servers for browsing topics (default: 13.135.14.116:9094)
# Override with: terraform -chdir=../infra output -raw kafka_bootstrap_servers
# KAFKA_BOOTSTRAP_SERVERS=
